# Configuração de desenvolvimento. Não utilizar credenciais reais neste arquivo.
DATABASE_URL=postgresql://agendaflow:agendaflow_local@localhost:5432/agendaflow
PORT=3333
HOST=127.0.0.1
WEB_ORIGIN=http://127.0.0.1:5173
# Em produção, configurar NODE_ENV=production e HTTPS.
# Primeiro administrador: ADMIN_NAME, ADMIN_EMAIL, ADMIN_PASSWORD em variáveis temporárias.
BUSINESS_TIMEZONE=America/Sao_Paulo
# Em produção: WEB_ORIGIN deve usar HTTPS; configurar domínio no proxy reverso.
