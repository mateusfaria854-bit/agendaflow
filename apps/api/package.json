{
  "name": "@agendaflow/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:verify": "tsx src/db/verify.ts",
    "admin:create": "tsx src/db/create-admin.ts",
    "staff:provision": "tsx src/db/provision-staff.ts",
    "db:migrate:runtime": "node dist/db/migrate.js",
    "db:seed:runtime": "node dist/db/seed.js",
    "admin:create:runtime": "node dist/db/create-admin.js",
    "staff:provision:runtime": "node dist/db/provision-staff.js",
    "db:demo:cleanup": "tsx src/db/demo-cleanup.ts",
    "db:demo:cleanup:runtime": "node dist/db/demo-cleanup.js"
  },
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "@agendaflow/shared": "0.1.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2"
  }
}
